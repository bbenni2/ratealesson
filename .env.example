# Supabase – findest du im Supabase Dashboard unter:
# Project Settings -> API
#
# Kopiere diese Datei zu ".env" und trag deine Werte ein:
#   cp .env.example .env

# Projekt-URL (z. B. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Öffentlicher "anon" Public Key (NICHT der service_role Key!)
VITE_SUPABASE_ANON_KEY=
